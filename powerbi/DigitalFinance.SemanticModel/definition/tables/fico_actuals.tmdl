					{"1000", "1000", 2026, 2, "4001000", "420000", "Personnel & production costs", "USD", 191200, 175000},
					{"1000", "1000", 2026, 2, "4002000", "476000", "Logistics & freight costs", "USD", 102300, 100000},
					{"1000", "1000", 2026, 2, "4003000", "617000", "Corporate overhead allocation", "USD", 53800, 52000},
					{"1000", "1000", 2026, 2, "4004000", "490000", "IT operating costs", "USD", 68900, 65000},
					{"1000", "1000", 2026, 3, "4001000", "420000", "Personnel & production costs", "USD", 178300, 177000},
