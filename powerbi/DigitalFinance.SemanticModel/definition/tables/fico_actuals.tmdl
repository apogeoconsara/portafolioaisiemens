					{"1000", "1000", 2026, 3, "4003000", "617000", "Corporate overhead allocation", "USD", 55600, 53000},
					{"1000", "1000", 2026, 3, "4004000", "490000", "IT operating costs", "USD", 74200, 67000},
					{"1000", "1000", 2026, 4, "4001000", "420000", "Personnel & production costs", "USD", 205100, 180000},
					{"1000", "1000", 2026, 4, "4002000", "476000", "Logistics & freight costs", "USD", 108700, 102000},
					{"1000", "1000", 2026, 4, "4003000", "617000", "Corporate overhead allocation", "USD", 54900, 54000},
					{"1000", "1000", 2026, 4, "4004000", "490000", "IT operating costs", "USD", 72100, 68000},
					{"1000", "1000", 2026, 4, "4009000", "476000", "Logistics & freight costs", "USD", 15000, 12000},
