table fico_actuals
	measure Real = SUM(fico_actuals[actual_amount])
		formatString: $#,0

	measure Plan = SUM(fico_actuals[plan_amount])
		formatString: $#,0

	measure Variacion = [Real] - [Plan]
		formatString: $#,0;-$#,0

	measure 'Variacion %' = DIVIDE([Variacion], [Plan])
		formatString: 0.0%;-0.0%

	measure 'Real YTD' = CALCULATE([Real], FILTER(ALL(fico_actuals[poper]), fico_actuals[poper] <= MAX(fico_actuals[poper])))
		formatString: $#,0

	measure 'Plan YTD' = CALCULATE([Plan], FILTER(ALL(fico_actuals[poper]), fico_actuals[poper] <= MAX(fico_actuals[poper])))
		formatString: $#,0

	measure 'Variacion YTD %' = DIVIDE([Real YTD] - [Plan YTD], [Plan YTD])
		formatString: 0.0%;-0.0%

	measure 'Color variacion' = IF(ABS([Variacion %]) <= 0.03, "#1a9c63", IF(ABS([Variacion %]) <= 0.08, "#b5720a", "#d1373f"))
		displayFolder: Formato condicional

	measure 'Partidas sin maestro' = COUNTROWS(FILTER(fico_actuals, ISBLANK(RELATED(cost_center_master[kostl]))))
		formatString: 0
		displayFolder: Calidad de datos

	measure 'Gasto en bloqueados' = CALCULATE([Real], cost_center_master[status] = "BLOCKED")
		formatString: $#,0
		displayFolder: Calidad de datos

	column bukrs
		dataType: string
		sourceColumn: bukrs
		summarizeBy: none

	column kokrs
		dataType: string
		sourceColumn: kokrs
		summarizeBy: none

	column gjahr
		dataType: int64
		sourceColumn: gjahr
		summarizeBy: none

	column poper
		dataType: int64
		sourceColumn: poper
		summarizeBy: none

	column kostl
		dataType: string
		sourceColumn: kostl
		summarizeBy: none

	column kstar
		dataType: string
		sourceColumn: kstar
		summarizeBy: none

	column kstar_name
		dataType: string
		sourceColumn: kstar_name
		summarizeBy: none

	column waers
		dataType: string
		sourceColumn: waers
		summarizeBy: none

	column actual_amount
		dataType: double
		sourceColumn: actual_amount
		summarizeBy: sum

	column plan_amount
		dataType: double
		sourceColumn: plan_amount
		summarizeBy: sum

	partition fico_actuals = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "fico_actuals.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Headers, {{"bukrs", type text}, {"kokrs", type text}, {"gjahr", Int64.Type}, {"poper", Int64.Type}, {"kostl", type text}, {"kstar", type text}, {"kstar_name", type text}, {"waers", type text}, {"actual_amount", type number}, {"plan_amount", type number}}, "en-US")
			in
			    Typed
