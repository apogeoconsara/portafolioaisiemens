table inventory_mm
	measure Stock = SUM(inventory_mm[labst])
		formatString: #,0

	measure 'Punto de reorden' = SUM(inventory_mm[minbe])
		formatString: #,0

	measure 'Lineas bajo reorden' = COUNTROWS(FILTER(inventory_mm, inventory_mm[labst] <= inventory_mm[minbe]))
		formatString: 0

	column gjahr
		dataType: int64
		sourceColumn: gjahr
		summarizeBy: none

	column poper
		dataType: int64
		sourceColumn: poper
		summarizeBy: none

	column werks
		dataType: string
		sourceColumn: werks
		summarizeBy: none

	column lgort
		dataType: string
		sourceColumn: lgort
		summarizeBy: none

	column matnr
		dataType: string
		sourceColumn: matnr
		summarizeBy: none

	column material_desc
		dataType: string
		sourceColumn: material_desc
		summarizeBy: none

	column labst
		dataType: double
		sourceColumn: labst
		summarizeBy: sum

	column minbe
		dataType: double
		sourceColumn: minbe
		summarizeBy: sum

	partition inventory_mm = m
		mode: import
		source =
			let
				Source = #table(
					{"gjahr", "poper", "werks", "lgort", "matnr", "material_desc", "labst", "minbe"},
					{
					{2026, 1, "1010", "0001", "100001", "Steel Coil 2mm", 12400, 11000},
					{2026, 1, "1020", "0001", "100002", "Packaging Crates", 8800, 9500},
					{2026, 2, "1010", "0001", "100001", "Steel Coil 2mm", 13100, 11000},
					{2026, 2, "1020", "0001", "100002", "Packaging Crates", 9600, 9500},
					{2026, 3, "1010", "0001", "100001", "Steel Coil 2mm", 11800, 11000},
					{2026, 3, "1020", "0001", "100002", "Packaging Crates", 9100, 9500},
					{2026, 4, "1010", "0001", "100001", "Steel Coil 2mm", 14200, 11500},
					{2026, 4, "1020", "0001", "100002", "Packaging Crates", 10300, 9500},
					{2026, 5, "1010", "0001", "100001", "Steel Coil 2mm", 12900, 11500},
					{2026, 5, "1020", "0001", "100002", "Packaging Crates", 9200, 9500},
					{2026, 6, "1010", "0001", "100001", "Steel Coil 2mm", 13600, 11500},
					{2026, 6, "1020", "0001", "100002", "Packaging Crates", 9900, 9500}
					}
				),
				Typed = Table.TransformColumnTypes(Source, {{"gjahr", Int64.Type}, {"poper", Int64.Type}, {"werks", type text}, {"lgort", type text}, {"matnr", type text}, {"material_desc", type text}, {"labst", type number}, {"minbe", type number}}, "en-US")
			in
				Typed
