table cost_center_master

	column kokrs
		dataType: string
		sourceColumn: kokrs
		summarizeBy: none

	column bukrs
		dataType: string
		sourceColumn: bukrs
		summarizeBy: none

	column kostl
		dataType: string
		sourceColumn: kostl
		summarizeBy: none

	column kostl_name
		dataType: string
		sourceColumn: kostl_name
		summarizeBy: none

	column kostl_group
		dataType: string
		sourceColumn: kostl_group
		summarizeBy: none

	column werks
		dataType: string
		sourceColumn: werks
		summarizeBy: none

	column status
		dataType: string
		sourceColumn: status
		summarizeBy: none

	partition cost_center_master = m
		mode: import
		source =
			let
				Source = #table(
					{"kokrs", "bukrs", "kostl", "kostl_name", "kostl_group", "werks", "status"},
					{
					{"1000", "1000", "4001000", "Machining & Assembly", "MFG", "1010", "ACTIVE"},
					{"1000", "1000", "4002000", "Warehousing & Logistics", "SCM", "1020", "ACTIVE"},
					{"1000", "1000", "4003000", "Finance & Controlling", "FICO", "1000", "ACTIVE"},
					{"1000", "1000", "4004000", "IT & Digital Services", "ITD", "1000", "BLOCKED"}
					}
				),
				Typed = Table.TransformColumnTypes(Source, {{"kokrs", type text}, {"bukrs", type text}, {"kostl", type text}, {"kostl_name", type text}, {"kostl_group", type text}, {"werks", type text}, {"status", type text}}, "en-US")
			in
				Typed
